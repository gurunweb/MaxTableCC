{
  "_comment": "Whitelist установленных/доступных MCP-серверов. Claude использует записи отсюда при подключении MCP к чату/проекту/глобально — это защита от ввода произвольного npm-пакета. Поле 'command'+'args' копируется в финальный mcp.json для запуска. Поле 'env' опционально. Поле 'docs' — короткое описание для юзера.",
  "servers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--browser=chromium"],
      "env": { "DISPLAY": ":1" },
      "userDataDirArg": "--user-data-dir",
      "docs": "Браузер-автоматизация. Скриншоты, парсинг, заполнение форм."
    },
    "fetch": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch"],
      "docs": "HTTP-фетч с фоллбэком на content-extraction."
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem"],
      "argsPlaceholder": "workdir",
      "docs": "Структурированный доступ к ФС. Аргумент = корневая папка."
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "envRequired": ["GITHUB_PERSONAL_ACCESS_TOKEN"],
      "docs": "Работа с GitHub: issues, PR, репо. Требует GITHUB_PERSONAL_ACCESS_TOKEN."
    },
    "postgres": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres"],
      "argsPlaceholder": "connection_url",
      "docs": "PostgreSQL: SELECT-запросы. Аргумент = postgres://user:pass@host/db."
    },
    "sqlite": {
      "command": "npx",
      "args": ["-y", "mcp-server-sqlite"],
      "argsPlaceholder": "db_path",
      "docs": "SQLite: запросы. Аргумент = путь к .sqlite файлу."
    },
    "slack": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-slack"],
      "envRequired": ["SLACK_BOT_TOKEN", "SLACK_TEAM_ID"],
      "docs": "Slack: посты, чтение каналов."
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "docs": "Локальный knowledge-graph для долговременной памяти Claude."
    },
    "puppeteer": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-puppeteer"],
      "docs": "Альтернатива playwright на puppeteer."
    }
  }
}
