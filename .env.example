# cc-bridge environment
# Production: /etc/cc-bridge/env (readable by maxclaude)

# Порт на котором слушает cc-bridge (Caddy проксирует 443 → localhost:PORT)
PORT=8080
HOST=127.0.0.1

# Shared secret с MaxTableSaaS — проверяется в middleware при каждом запросе
# Генерировать так: head -c 48 /dev/urandom | base64 | tr -d '+/=' | head -c 48
CLOUDCODE_BRIDGE_TOKEN=CHANGE_ME_TO_RANDOM_48_CHAR_STRING

# Путь к workdir'ам Claude-сессий
WORKSPACES_ROOT=/workspaces

# Путь к SQLite БД
DATABASE_PATH=/var/lib/cc-bridge/db.sqlite

# Путь к Claude CLI
CLAUDE_BIN=/home/maxclaude/.local/bin/claude

# Long-lived OAuth токен подписки Claude Max (получить через `claude setup-token`)
# Токен читается дочерним процессом claude автоматически через env
# Действует 1 год — обновлять через `claude setup-token` до истечения
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-CHANGE_ME

# Логи
LOG_LEVEL=info
